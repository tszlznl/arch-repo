# Maintainer: tszlznl
pkgname=colab-playground-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="A desktop app for the Google Colab CLI: accounts, GPU sessions with cost guards, port forwarding and plugins"
arch=('x86_64')
url="https://github.com/scarletkc/colab-playground"
license=('MIT')
depends=('fontconfig' 'freetype2' 'libxkbcommon' 'libx11' 'libxcb' 'gtk3')
options=('!strip')
source=("https://github.com/scarletkc/colab-playground/releases/download/v${pkgver}/colab-playground-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('e7f4c6cd4bcc2c13f9540587f50cffb6d88636a66e868627a3238618fb918dce')

package() {
    cd "${srcdir}/colab-playground-x86_64-unknown-linux-gnu"
    install -Dm755 colab-playground "${pkgdir}/usr/bin/colab-playground"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -d "${pkgdir}/usr/share/applications"
    cat << 'DESKTOP' > "${pkgdir}/usr/share/applications/colab-playground.desktop"
[Desktop Entry]
Type=Application
Name=Colab Playground
Comment=A desktop app for the Google Colab CLI
Exec=/usr/bin/colab-playground
Terminal=false
Categories=Development;Utility;
DESKTOP
}
