# Maintainer: tszlznl
pkgname=denova-bin
pkgver=0.8.0
pkgrel=1
pkgdesc="AI Novel Writing & Role-Playing Workbench (开源 AI 小说写作与角色扮演工具)"
arch=('x86_64')
url="https://github.com/alfredxw/denova"
license=('Apache-2.0')
depends=('glibc')
options=('!strip')
source=("https://github.com/alfredxw/denova/releases/download/v${pkgver}/denova-webui-v${pkgver}-linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/denova"
    install -d "${pkgdir}/usr/lib/denova"
    cp -r denova config.toml skills tools web "${pkgdir}/usr/lib/denova/" 2>/dev/null || cp -r * "${pkgdir}/usr/lib/denova/"
    chmod 755 "${pkgdir}/usr/lib/denova/denova"

    install -d "${pkgdir}/usr/bin"
    # Create wrapper to set working dir or DENOVA_DIR if needed
    cat << 'WRAPPER' > "${pkgdir}/usr/bin/denova"
#!/bin/sh
if [ -z "${DENOVA_DIR:-}" ]; then
  DENOVA_DIR="$HOME/.denova"
  export DENOVA_DIR
fi
exec /usr/lib/denova/denova "$@"
WRAPPER
    chmod 755 "${pkgdir}/usr/bin/denova"

    # Install desktop file
    install -d "${pkgdir}/usr/share/applications"
    cat << 'DESKTOP' > "${pkgdir}/usr/share/applications/denova.desktop"
[Desktop Entry]
Type=Application
Name=Denova
Comment=AI Novel Writing & Role-Playing Workbench
Exec=/usr/bin/denova
Icon=denova
Terminal=false
Categories=Office;Development;Utility;
DESKTOP
}
